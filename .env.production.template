# ==============================================================================
# SignFlow Production Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to `.env.production` (or your secret manager / hosting dashboard).
# 2. Replace all `YOUR_*` placeholders with your real production values.
# 3. NEVER commit `.env.production` or any file containing real credentials to Git.
#
# SECURITY REQUIREMENTS CHECKLIST:
# - [ ] NODE_ENV must be set to "production"
# - [ ] NEXT_PUBLIC_WEBAPP_URL must use HTTPS (e.g. https://app.signflow.com)
# - [ ] NEXTAUTH_SECRET must be a random 32+ character string (generate: openssl rand -base64 32)
# - [ ] NEXT_PRIVATE_ENCRYPTION_KEY and NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY must be
#       random, unique, and DIFFERENT from each other.
# - [ ] Do NOT use development/test secrets ("secret", "CAFEBABE", "DEADBEEF").
# - [ ] Do NOT set DANGEROUS_BYPASS_RATE_LIMITS in production.
# - [ ] Internal ports for Database (5432), Redis (6379), and Gotenberg (3000) must NOT
#       be exposed to the public Internet.
# - [ ] Inbucket is for local development only and must NOT be deployed to production.
# ==============================================================================

# ==============================================================================
# 1. APPLICATION CONFIGURATION
# ==============================================================================
# [REQUIRED] Node environment mode. Enables secure cookies, disables dev helpers.
# Difference: Development uses "development"; Production MUST use "production".
NODE_ENV="production"

# [REQUIRED] The public canonical HTTPS URL where users access SignFlow.
# Used for email action links, OAuth redirects, and CSRF / cookie scoping.
# Difference: Development uses "http://localhost:3000"; Production MUST be HTTPS.
NEXT_PUBLIC_WEBAPP_URL="https://YOUR_PRODUCTION_DOMAIN"

# [REQUIRED] Support email address shown to users across error pages, signature disclosures, and support links.
# Difference: Dev falls back to "support@documenso.com"; Production should be your verified support address.
NEXT_PUBLIC_SUPPORT_EMAIL="support@YOUR_PRODUCTION_DOMAIN"

# [OPTIONAL] The internal loopback URL used by the server to query itself.
# Defaults to "http://localhost:3000" inside the container.
NEXT_PRIVATE_INTERNAL_WEBAPP_URL="http://localhost:3000"

# [OPTIONAL] Application HTTP port inside the container. Defaults to 3000.
PORT=3000

# [OPTIONAL] Maximum document upload size limit in MB displayed to users. Defaults to 5 or 10.
NEXT_PUBLIC_DOCUMENT_SIZE_UPLOAD_LIMIT=10

# [OPTIONAL] Comma-separated list of domains allowed for signup (e.g. acme.com,partner.org).
# Leave empty to allow all domains.
NEXT_PRIVATE_ALLOWED_SIGNUP_DOMAINS=""

# [OPTIONAL] Set to "true" to disable self-registration (enforces invite-only / admin-created users).
NEXT_PUBLIC_DISABLE_SIGNUP=

# [OPTIONAL] Set to "true" to disable email/password signup (forces SSO).
NEXT_PUBLIC_DISABLE_EMAIL_PASSWORD_SIGNUP=

# [OPTIONAL] Set to "true" to disable email/password login (forces SSO).
NEXT_PUBLIC_DISABLE_EMAIL_PASSWORD_SIGNIN=

# ==============================================================================
# 2. DATABASE CONFIGURATION
# ==============================================================================
# [REQUIRED - SECRET] PostgreSQL connection URL used by Prisma runtime queries.
# Supports connection poolers (e.g. PgBouncer / Supabase / AWS RDS Proxy).
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# Difference: Dev uses local container ("postgres://documenso:password@127.0.0.1:54320/documenso").
#             Prod uses a private network host or managed cloud database with strong password.
NEXT_PRIVATE_DATABASE_URL="postgres://YOUR_DATABASE_USER:YOUR_DATABASE_PASSWORD@signflow-database:5432/YOUR_DATABASE_NAME"

# [REQUIRED - SECRET] Direct unpooled PostgreSQL connection URL.
# Required for `prisma migrate deploy` (DDL schema migrations) which fail with transaction poolers.
# If not using an external connection pooler, set this to the same value as NEXT_PRIVATE_DATABASE_URL.
NEXT_PRIVATE_DIRECT_DATABASE_URL="postgres://YOUR_DATABASE_USER:YOUR_DATABASE_PASSWORD@signflow-database:5432/YOUR_DATABASE_NAME"

# [REQUIRED FOR DOCKER COMPOSE - SECRET] Credentials for the internal PostgreSQL container.
# Only required if running PostgreSQL via the included Docker Compose service.
POSTGRES_USER="YOUR_DATABASE_USER"
POSTGRES_PASSWORD="YOUR_STRONG_DATABASE_PASSWORD"
POSTGRES_DB="YOUR_DATABASE_NAME"

# ==============================================================================
# 3. AUTHENTICATION & SESSIONS
# ==============================================================================
# [REQUIRED - SECRET] Cryptographic secret used to sign NextAuth session cookies and CSRF tokens.
# Must be at least 32 characters long.
# Generate with: openssl rand -base64 32
# Difference: Dev uses "secret"; Production MUST use a cryptographically random secret.
NEXTAUTH_SECRET="YOUR_RANDOM_32_CHAR_NEXTAUTH_SECRET"

# ==============================================================================
# 4. ENCRYPTION KEYS
# ==============================================================================
# [REQUIRED - SECRET] Primary application key for symmetric AES encryption of sensitive database fields.
# Must be a random string of at least 32 characters.
# Generate with: openssl rand -base64 32
# Difference: Dev uses "CAFEBABE"; Production MUST use a random secret.
NEXT_PRIVATE_ENCRYPTION_KEY="YOUR_PRIMARY_RANDOM_32_CHAR_ENCRYPTION_KEY"

# [REQUIRED - SECRET] Secondary application key for miscellaneous encrypted tokens (email verification, etc.).
# Must be a random string of at least 32 characters and MUST BE DIFFERENT from the primary key.
# Generate with: openssl rand -base64 32
# Difference: Dev uses "DEADBEEF"; Production MUST be distinct from NEXT_PRIVATE_ENCRYPTION_KEY.
NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY="YOUR_SECONDARY_RANDOM_32_CHAR_ENCRYPTION_KEY"

# ==============================================================================
# 5. STORAGE (S3-COMPATIBLE OBJECT STORAGE)
# ==============================================================================
# [REQUIRED] Storage transport to use. Set to "s3" for production.
# Difference: Dev defaults to "database" (base64 in DB) or MinIO; Prod should always use "s3".
NEXT_PUBLIC_UPLOAD_TRANSPORT="s3"

# [REQUIRED] S3 bucket name. Must be 100% private with no public read access.
NEXT_PRIVATE_UPLOAD_BUCKET="YOUR_STORAGE_BUCKET_NAME"

# [REQUIRED] S3 region (e.g. "us-east-1", "eu-central-1", or "auto" for Cloudflare R2).
NEXT_PRIVATE_UPLOAD_REGION="YOUR_STORAGE_REGION"

# [OPTIONAL] S3 API endpoint.
# - Leave empty for standard AWS S3.
# - For Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# - For MinIO / custom S3: https://storage.yourdomain.com
NEXT_PRIVATE_UPLOAD_ENDPOINT=""

# [OPTIONAL] Set to "true" if using path-style S3 URLs (required for MinIO/custom S3).
# Set to "false" for AWS S3 and Cloudflare R2 virtual-hosted paths.
NEXT_PRIVATE_UPLOAD_FORCE_PATH_STYLE="false"

# [REQUIRED - SECRET] S3 IAM access key ID or API token with PutObject/GetObject permissions.
NEXT_PRIVATE_UPLOAD_ACCESS_KEY_ID="YOUR_STORAGE_ACCESS_KEY_ID"

# [REQUIRED - SECRET] S3 IAM secret access key.
NEXT_PRIVATE_UPLOAD_SECRET_ACCESS_KEY="YOUR_STORAGE_SECRET_ACCESS_KEY"

# ==============================================================================
# 6. REDIS & BACKGROUND JOBS (BULLMQ)
# ==============================================================================
# [REQUIRED] Job queue driver. Set to "bullmq" in production for durable background workers.
# BullMQ handles document sealing, signature timestamps, email dispatch, and webhooks.
NEXT_PRIVATE_JOBS_PROVIDER="bullmq"

# [REQUIRED - SECRET] Redis connection URL.
# Format: redis://:PASSWORD@HOST:PORT
# Difference: Dev uses "redis://localhost:63790"; Prod connects to internal Redis or managed instance.
NEXT_PRIVATE_REDIS_URL="redis://:YOUR_REDIS_PASSWORD@signflow-redis:6379"

# [OPTIONAL] Namespace prefix for Redis queue keys.
NEXT_PRIVATE_REDIS_PREFIX="signflow"

# [OPTIONAL] Worker concurrency for background processing. Defaults to 10.
NEXT_PRIVATE_BULLMQ_CONCURRENCY=10

# [REQUIRED FOR DOCKER COMPOSE - SECRET] Redis password for the internal Redis service.
# Only required if using the included Redis container in docker/production/compose.yml.
REDIS_PASSWORD="YOUR_STRONG_REDIS_PASSWORD"

# ==============================================================================
# 7. EMAIL CONFIGURATION (TRANSACTIONAL EMAIL)
# ==============================================================================
# [REQUIRED] Email delivery transport.
# Options: "smtp-auth" (standard SMTP) | "smtp-api" (SendGrid API user) | "resend" (Resend API)
NEXT_PRIVATE_SMTP_TRANSPORT="smtp-auth"

# [REQUIRED for SMTP] SMTP server hostname (e.g. smtp.sendgrid.net, email-smtp.us-east-1.amazonaws.com).
NEXT_PRIVATE_SMTP_HOST="YOUR_SMTP_HOST"

# [REQUIRED for SMTP] SMTP server port: 587 (STARTTLS) or 465 (SSL/TLS).
NEXT_PRIVATE_SMTP_PORT=587

# [REQUIRED for SMTP] Force TLS on connection (set to "true" for port 465, "false" for 587 STARTTLS).
NEXT_PRIVATE_SMTP_SECURE="false"

# [REQUIRED for SMTP - SECRET] SMTP username.
NEXT_PRIVATE_SMTP_USERNAME="YOUR_SMTP_USERNAME"

# [REQUIRED for SMTP - SECRET] SMTP password or API token.
NEXT_PRIVATE_SMTP_PASSWORD="YOUR_SMTP_PASSWORD"

# [REQUIRED] Sender display name shown in recipient inboxes.
NEXT_PRIVATE_SMTP_FROM_NAME="SignFlow"

# [REQUIRED] Verified sender email address (must match your SPF/DKIM configured domain).
NEXT_PRIVATE_SMTP_FROM_ADDRESS="noreply@YOUR_PRODUCTION_DOMAIN"

# [OPTIONAL - SECRET] Resend API key (only when NEXT_PRIVATE_SMTP_TRANSPORT="resend").
NEXT_PRIVATE_RESEND_API_KEY=""

# ==============================================================================
# 8. DOCUMENT CONVERSION (GOTENBERG MICROSERVICE)
# ==============================================================================
# [REQUIRED IF ENABLING DOCX CONVERSION] Internal endpoint to Gotenberg microservice.
# When unset, DOCX uploads are disabled and users can only upload PDF files.
# In production compose, Gotenberg is internal-only and never exposed to the Internet.
NEXT_PRIVATE_DOCUMENT_CONVERSION_URL="http://signflow-gotenberg:3000"

# [OPTIONAL] Conversion request timeout in milliseconds. Defaults to 30000 (30 seconds).
NEXT_PRIVATE_DOCUMENT_CONVERSION_TIMEOUT_MS=30000

# [REQUIRED FOR GOTENBERG AUTH - SECRET] Basic auth credentials for Gotenberg.
GOTENBERG_API_BASIC_AUTH_USERNAME="signflow_gotenberg_user"
GOTENBERG_API_BASIC_AUTH_PASSWORD="YOUR_STRONG_GOTENBERG_PASSWORD"

# ==============================================================================
# 9. DIGITAL SIGNING CERTIFICATE (PKCS#12 / P12)
# ==============================================================================
# [REQUIRED] Signing transport. Options: "local" (default) | "gcloud-hsm" | "csc"
NEXT_PRIVATE_SIGNING_TRANSPORT="local"

# [REQUIRED FOR LOCAL SIGNING] Path inside the container to the production .p12 certificate file.
# In Docker compose, mounted via volume from host path SIGNING_CERT_HOST_PATH.
NEXT_PRIVATE_SIGNING_LOCAL_FILE_PATH="/opt/signflow/cert.p12"

# [REQUIRED IF ENCRYPTED - SECRET] Passphrase to unlock the .p12 certificate file.
NEXT_PRIVATE_SIGNING_PASSPHRASE="YOUR_CERTIFICATE_PASSPHRASE"

# [OPTIONAL] Host path to the .p12 file to mount into the production container.
SIGNING_CERT_HOST_PATH="./cert.p12"

# ==============================================================================
# 10. OAUTH / SSO CONFIGURATION (OPTIONAL)
# ==============================================================================
# Google OAuth
# Register callback URL: https://YOUR_PRODUCTION_DOMAIN/api/auth/callback/google
NEXT_PRIVATE_GOOGLE_CLIENT_ID=""
NEXT_PRIVATE_GOOGLE_CLIENT_SECRET=""

# Microsoft Azure AD OAuth
# Register callback URL: https://YOUR_PRODUCTION_DOMAIN/api/auth/callback/microsoft
NEXT_PRIVATE_MICROSOFT_CLIENT_ID=""
NEXT_PRIVATE_MICROSOFT_CLIENT_SECRET=""

# Custom OIDC / SSO Provider (Okta, Keycloak, Auth0, etc.)
# Register callback URL: https://YOUR_PRODUCTION_DOMAIN/api/auth/callback/oidc
NEXT_PRIVATE_OIDC_WELL_KNOWN=""
NEXT_PRIVATE_OIDC_CLIENT_ID=""
NEXT_PRIVATE_OIDC_CLIENT_SECRET=""
NEXT_PRIVATE_OIDC_PROVIDER_LABEL="Enterprise SSO"

# ==============================================================================
# 11. CLOUDFLARE TURNSTILE CAPTCHA (OPTIONAL)
# ==============================================================================
# Public Turnstile site key for anti-bot protection on signup and signin.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# [SECRET] Private Turnstile secret key for server-side validation.
NEXT_PRIVATE_TURNSTILE_SECRET_KEY=""

# ==============================================================================
# 12. TELEMETRY & ANALYTICS
# ==============================================================================
# [REQUIRED FOR SIGNFLOW] Disable upstream Documenso usage telemetry.
# MUST be set to "true" so no data is reported upstream.
DOCUMENSO_DISABLE_TELEMETRY="true"

# [OPTIONAL] Your own PostHog project API key for internal product telemetry.
# Leave blank to disable analytics.
NEXT_PUBLIC_POSTHOG_KEY=""

# ==============================================================================
# 13. BILLING & SUBSCRIPTIONS (DOCUMENT ONLY - DO NOT ACTIVATE YET)
# ==============================================================================
# Set to "true" to activate Stripe billing module.
# Leave blank or "false" until billing is ready.
NEXT_PUBLIC_FEATURE_BILLING_ENABLED="false"

# [SECRET] Stripe API secret key (e.g. sk_live_... or sk_test_...).
NEXT_PRIVATE_STRIPE_API_KEY=""

# [SECRET] Stripe webhook endpoint signing secret (e.g. whsec_...).
NEXT_PRIVATE_STRIPE_WEBHOOK_SECRET=""

# ==============================================================================
# 14. ARTIFICIAL INTELLIGENCE (OPTIONAL)
# ==============================================================================
# Google Cloud Vertex AI (Gemini) configuration for AI-assisted field detection.
GOOGLE_VERTEX_PROJECT_ID=""
GOOGLE_VERTEX_LOCATION="global"
GOOGLE_VERTEX_API_KEY=""
